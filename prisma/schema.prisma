generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id           String        @id @default(cuid())
  code         String        @unique @db.VarChar(24)
  name         String        @db.VarChar(120)
  customerName String        @db.VarChar(120)
  description  String        @default("") @db.VarChar(4000)
  status       ProjectStatus @default(PLANNED)
  siteName     String        @db.VarChar(120)
  siteAddress  String        @db.VarChar(240)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([createdAt])
}
